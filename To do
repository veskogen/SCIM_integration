using Microsoft.AspNetCore.Mvc;
using System.Text.Json.Serialization;
using System.Text.Json;
using System.Net;
using System.Collections.Concurrent;
using Newtonsoft.Json;

var builder = WebApplication.CreateBuilder(args);

// Configure JSON serialization to ignore null values
builder.Services.ConfigureHttpJsonOptions(options =>
{
    options.SerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    options.SerializerOptions.DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull;
});

var app = builder.Build();

// --- SCIM Endpoint Setup ---
// SCIM endpoints are typically at a path like /scim/v2.
const string ScimBasePath = "/scim/v2";

// In-memory "database" to simulate the employee system
var employeeDatabase = new ConcurrentDictionary<string, Employee>();

// --- SCIM 2.0 User Schema ---
// This is a simplified user model that mimics common SCIM attributes.
// The actual SCIM schema is more complex (RFC 7643).
record Employee(
    string Id,
    string UserName,
    string FirstName,
    string LastName,
    string Email,
    bool Active
);

// --- SCIM 2.0 Endpoints ---

// GET /Users: List users
app.MapGet($"{ScimBasePath}/Users", () =>
{
    Console.WriteLine("Received GET /Users request.");
    return Results.Ok(new
    {
        schemas = new[] { "urn:ietf:params:scim:api:messages:2.0:ListResponse" },
        totalResults = employeeDatabase.Count,
        Resources = employeeDatabase.Values
    });
});

// GET /Users/{id}: Retrieve a single user
app.MapGet($"{ScimBasePath}/Users/{{id}}", ([FromRoute] string id) =>
{
    Console.WriteLine($"Received GET /Users/{id} request.");
    if (employeeDatabase.TryGetValue(id, out var employee))
    {
        return Results.Ok(employee);
    }
    return Results.NotFound();
});

// POST /Users: Create a new user
app.MapPost($"{ScimBasePath}/Users", ([FromBody] JsonElement json) =>
{
    Console.WriteLine("Received POST /Users request.");
    // For a real app, you would parse the SCIM payload here
    // In this dummy, we just print the raw JSON and create a new user.
    Console.WriteLine("Incoming SCIM Payload: " + json.ToString());

    // Extracting user data from the simplified payload
    var userName = json.TryGetProperty("userName", out var name) ? name.GetString() : "unknown";
    var active = json.TryGetProperty("active", out var activeProp) && activeProp.GetBoolean();
    var email = json.TryGetProperty("emails", out var emails) && emails.EnumerateArray().Any()
        ? emails.EnumerateArray().First().GetProperty("value").GetString()
        : "no-email@example.com";
    
    // Simulate attribute parsing from the SCIM payload
    var nameJson = json.TryGetProperty("name", out var nameProperty) ? nameProperty : new JsonElement();
    var firstName = nameJson.TryGetProperty("givenName", out var givenName) ? givenName.GetString() : "Test";
    var lastName = nameJson.TryGetProperty("familyName", out var familyName) ? familyName.GetString() : "User";

    // Create and save the new employee
    var newEmployee = new Employee(
        Id: Guid.NewGuid().ToString(),
        UserName: userName,
        FirstName: firstName,
        LastName: lastName,
        Email: email,
        Active: active
    );

    employeeDatabase.TryAdd(newEmployee.Id, newEmployee);

    return Results.Created($"{ScimBasePath}/Users/{newEmployee.Id}", newEmployee);
});

// PUT /Users/{id}: Update a user
app.MapPut($"{ScimBasePath}/Users/{{id}}", ([FromRoute] string id, [FromBody] JsonElement json) =>
{
    Console.WriteLine($"Received PUT /Users/{id} request.");
    if (employeeDatabase.TryGetValue(id, out var existingEmployee))
    {
        // For a real app, you'd parse the SCIM payload and perform a full replace.
        var userName = json.TryGetProperty("userName", out var name) ? name.GetString() : existingEmployee.UserName;
        var active = json.TryGetProperty("active", out var activeProp) ? activeProp.GetBoolean() : existingEmployee.Active;
        
        var nameJson = json.TryGetProperty("name", out var nameProperty) ? nameProperty : new JsonElement();
        var firstName = nameJson.TryGetProperty("givenName", out var givenName) ? givenName.GetString() : existingEmployee.FirstName;
        var lastName = nameJson.TryGetProperty("familyName", out var familyName) ? familyName.GetString() : existingEmployee.LastName;
        
        var updatedEmployee = existingEmployee with
        {
            UserName = userName,
            Active = active,
            FirstName = firstName,
            LastName = lastName
        };

        employeeDatabase.TryUpdate(id, updatedEmployee, existingEmployee);
        return Results.Ok(updatedEmployee);
    }
    return Results.NotFound();
});

// DELETE /Users/{id}: Delete a user
app.MapDelete($"{ScimBasePath}/Users/{{id}}", ([FromRoute] string id) =>
{
    Console.WriteLine($"Received DELETE /Users/{id} request.");
    if (employeeDatabase.TryRemove(id, out _))
    {
        // SCIM protocol typically returns a 204 No Content for successful deletion.
        return Results.NoContent();
    }
    return Results.NotFound();
});

