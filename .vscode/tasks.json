{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dotnet run",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run"
			]
		},
		{
			"label": "dotnet build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build"
			],
			"group": "build"
		},
		{
			"label": "clean",
			"command": "dotnet",
			"type": "process",
			"args": [
				"clean",
				"${workspaceFolder}/SCIM_integration",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish-release",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/SCIM_integration",
				"--configuration",
				"Release",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"dependsOn": "clean"
		}
	]
}